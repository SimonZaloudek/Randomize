@page "/contact"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject LocalizationService Loc
@implements IAsyncDisposable

<PageTitle>@Loc["contact.pageTitle"]</PageTitle>

<h2 class="page-title">@Loc["contact.title"]</h2>

<div class="contact-layout">
    <section class="contact-card tool-card">
        <p class="contact-intro">@Loc["contact.intro"]</p>

        <EditForm Model="_form" OnValidSubmit="Submit" class="contact-form">
            <DataAnnotationsValidator />

            <div class="contact-type-row" role="radiogroup" aria-label="@Loc["contact.typeAria"]">
                @foreach (var opt in _typeOptions)
                {
                    var value = opt.Value;
                    <button type="button"
                            class="contact-type @(_form.Type == value ? "active" : "")"
                            role="radio"
                            aria-checked="@(_form.Type == value ? "true" : "false")"
                            @onclick="() => _form.Type = value"
                            disabled="@_busy">
                        <i class="bi @opt.Icon"></i>
                        <span>@Loc[opt.LabelKey]</span>
                    </button>
                }
            </div>

            <label class="contact-field">
                <span class="contact-field-label">@Loc["contact.email"]</span>
                <InputText class="tool-input" type="email" placeholder="@Loc["contact.emailPlaceholder"]"
                           @bind-Value="_form.Email" disabled="@_busy" />
                <ValidationMessage For="@(() => _form.Email)" />
            </label>

            <label class="contact-field">
                <span class="contact-field-label">@Loc["contact.name"] <span class="contact-field-hint">@Loc["contact.nameHint"]</span></span>
                <InputText class="tool-input" placeholder="@Loc["contact.namePlaceholder"]"
                           @bind-Value="_form.Name" disabled="@_busy" />
            </label>

            <label class="contact-field">
                <span class="contact-field-label">@Loc["contact.subject"]</span>
                <InputText class="tool-input" placeholder="@Loc["contact.subjectPlaceholder"]"
                           @bind-Value="_form.Subject" disabled="@_busy" />
            </label>

            <label class="contact-field">
                <span class="contact-field-label">@Loc["contact.message"]</span>
                <InputTextArea class="tool-input tool-textarea contact-message" rows="6"
                               placeholder="@Loc["contact.messagePlaceholder"]"
                               @bind-Value="_form.Message" disabled="@_busy" />
                <ValidationMessage For="@(() => _form.Message)" />
            </label>

            @* honeypot - hidden from humans; neutral class name on purpose *@
            <input type="text" name="website" tabindex="-1" autocomplete="off"
                   aria-hidden="true" class="contact-aux-field"
                   @bind="_form.Website" />

            <div id="cf-turnstile-container" class="contact-turnstile"></div>

            @if (_turnstileFailed)
            {
                <div class="contact-status err" role="status">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@Loc["contact.turnstileFail"]</span>
                </div>
            }

            <button type="submit" class="tool-btn contact-submit" disabled="@_busy">
                @if (_busy)
                {
                    <span>@Loc["contact.sending"]</span>
                }
                else
                {
                    <span>@Loc["contact.send"]</span>
                }
            </button>

            @if (_status is { } status)
            {
                <div class="contact-status @(status.Ok ? "ok" : "err")" role="status">
                    <i class="bi @(status.Ok ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                    <span>@status.Message</span>
                </div>
            }
        </EditForm>

        <p class="contact-privacy">@Loc["contact.privacy"]</p>
    </section>
</div>

@code {
    private const string TurnstileSiteKey = "0x4AAAAAADWxCBmOWYP6DeYv";

    private ContactForm _form = new();
    private bool _busy;
    private (bool Ok, string Message)? _status;
    private bool _turnstileRendered;
    private bool _turnstileFailed;
    private bool _disposed;

    private record TypeOption(string Value, string LabelKey, string Icon);

    private readonly TypeOption[] _typeOptions = new[]
    {
        new TypeOption("bug",     "contact.type.bug",     "bi-bug"),
        new TypeOption("feature", "contact.type.feature", "bi-lightbulb"),
        new TypeOption("other",   "contact.type.other",   "bi-chat-dots")
    };

    protected override void OnInitialized()
    {
        Loc.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _turnstileRendered) return;

        // retry until the async Turnstile script is ready; bail on dispose
        for (int i = 0; i < 15 && !_turnstileRendered && !_disposed; i++)
        {
            try
            {
                var ok = await JS.InvokeAsync<bool>("RandomizeTurnstile.render",
                                                    "#cf-turnstile-container",
                                                    TurnstileSiteKey);
                if (ok) { _turnstileRendered = true; break; }
            }
            catch when (_disposed)
            {
                return;
            }
            catch
            {
                // transient error - retry
            }
            await Task.Delay(200);
        }

        // script never loaded (blocker / network) - show a notice
        if (!_turnstileRendered && !_disposed)
        {
            _turnstileFailed = true;
            StateHasChanged();
        }
    }

    private async Task Submit()
    {
        _busy = true;
        _status = null;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string?>("RandomizeTurnstile.getToken");
            if (string.IsNullOrEmpty(token))
            {
                _status = (false, _turnstileRendered
                    ? Loc["contact.verifyPending"]
                    : Loc["contact.verifyMissing"]);
                return;
            }

            var res = await Http.PostAsJsonAsync("api/contact", new
            {
                type = _form.Type,
                name = _form.Name,
                email = _form.Email,
                subject = _form.Subject,
                message = _form.Message,
                website = _form.Website,
                turnstileToken = token
            });

            if (res.IsSuccessStatusCode)
            {
                _status = (true, Loc["contact.success"]);
                _form = new ContactForm();
                // tokens are single-use - refresh for the next submit
                await ResetTurnstileSafe();
            }
            else if ((int)res.StatusCode == 429)
            {
                _status = (false, Loc["contact.rateLimit"]);
                await ResetTurnstileSafe();
            }
            else if ((int)res.StatusCode == 403)
            {
                _status = (false, Loc["contact.verifyFail"]);
                await ResetTurnstileSafe();
            }
            else
            {
                _status = (false, Loc["contact.sendFail"]);
                await ResetTurnstileSafe();
            }
        }
        catch
        {
            _status = (false, Loc["contact.networkErr"]);
            await ResetTurnstileSafe();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ResetTurnstileSafe()
    {
        try { await JS.InvokeVoidAsync("RandomizeTurnstile.reset"); }
        catch { /* widget may already be gone */ }
    }

    public async ValueTask DisposeAsync()
    {
        Loc.LanguageChanged -= OnLanguageChanged;

        // stop the retry loop touching JS after teardown
        _disposed = true;

        // destroy the widget so the next mount starts clean
        try { await JS.InvokeVoidAsync("RandomizeTurnstile.remove"); }
        catch { /* JS interop torn down - nothing to clean up */ }
    }

    public sealed class ContactForm
    {
        public string Type { get; set; } = "bug";

        [StringLength(100, ErrorMessage = "Name is too long (100 characters max).")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "That doesn't look like a valid email.")]
        public string Email { get; set; } = "";

        [StringLength(200, ErrorMessage = "Subject is too long (200 characters max).")]
        public string? Subject { get; set; }

        [Required(ErrorMessage = "Message is required.")]
        [StringLength(5000, MinimumLength = 5, ErrorMessage = "Message must be 5–5000 characters.")]
        public string Message { get; set; } = "";

        // Honeypot - must stay empty.
        public string? Website { get; set; }
    }
}
