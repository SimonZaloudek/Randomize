@page "/wheel"
@using Randomize.Core.Wheel
@using Randomize.Web.Services
@inject IJSRuntime JS
@inject StatsClient Stats
@inject LocalizationService Loc
@implements IDisposable

<h2 class="page-title">@Loc["wheel.title"]</h2>

<div class="wheel-layout">

    <div class="wheel-stage">
        @if (_goatLine is not null)
        {
            <div class="wheel-question wheel-result-goat">@_goatLine</div>
        }
        else if (!string.IsNullOrWhiteSpace(_question))
        {
            <div class="wheel-question">@_question</div>
        }

        <!-- tap the wheel to spin; in image mode the canvas belongs to image editing -->
        <canvas id="wheelCanvas" class="wheel-canvas @(_images ? "is-image-mode" : "")"
                width="320" height="320" @onclick="OnCanvasClick"></canvas>

        <button class="tool-btn wheel-spin-btn" @onclick="SpinWheel" disabled="@(!CanSpin)">
            @SpinLabel
        </button>

        @if (_winners.Count > 0)
        {
            <div class="wheel-result wheel-result-list" @key="_winners.Count">
                @if (_goatLine is not null)
                {
                    <span class="wheel-result-question wheel-result-goat">@_goatLine</span>
                }
                else if (!string.IsNullOrWhiteSpace(_question))
                {
                    <span class="wheel-result-question">@_question</span>
                }
                <span class="wheel-result-label">@Loc["wheel.winners"]</span>
                <ol class="wheel-winners">
                    @foreach (var w in _winners)
                    {
                        <li>@w</li>
                    }
                </ol>
            </div>
        }
        else if (!string.IsNullOrEmpty(selectedResult))
        {
            <div class="wheel-result" @key="_spinCount">
                @if (_goatLine is not null)
                {
                    <span class="wheel-result-question wheel-result-goat">@_goatLine</span>
                }
                else if (!string.IsNullOrWhiteSpace(_question))
                {
                    <span class="wheel-result-question">@_question</span>
                }
                <span class="wheel-result-label">@Loc["wheel.winner"]</span>
                <span class="wheel-result-value">🎉 @selectedResult</span>
            </div>
        }
    </div>

    <div class="wheel-panel tool-card">
        <div class="option-row">
            <label class="wheel-question-row">
                <span class="opt-key">@Loc["wheel.question"]</span>
                <input class="tool-input" maxlength="80"
                       placeholder="@Loc["wheel.questionPh"]"
                       disabled="@_spinning"
                       @bind="_question" @bind:event="oninput" />
            </label>
        </div>

        <div class="option-row">
            <label>
                <span class="opt-key">@Loc["wheel.options"]</span>
                <input type="number" min="2" max="16" class="tool-input-small"
                       disabled="@_spinning"
                       @bind-value="rawCountInput" @oninput="HandleInput" @onblur="HandleBlur" />
            </label>
        </div>

        <div class="option-row option-row-wrap">
            <label>
                <input type="checkbox" @bind="_eliminate" disabled="@(_spinning || _raffle)" />
                @Loc["wheel.eliminate"]
            </label>
            <label>
                <input type="checkbox" checked="@_weighted" @onchange="ToggleWeighted" disabled="@_spinning" />
                @Loc["wheel.weighted"]
            </label>
            <label>
                <input type="checkbox" checked="@_raffle" @onchange="ToggleRaffle" disabled="@_spinning" />
                @Loc["wheel.raffle"]
            </label>
            <label title="@Loc["wheel.imagesTitle"]">
                <input type="checkbox" checked="@_images" @onchange="ToggleImages" disabled="@_spinning" />
                @Loc["wheel.images"]
            </label>
        </div>

        @if (_raffle)
        {
            <div class="option-row">
                <label>
                    <span class="opt-key">@Loc["wheel.drawCount"]</span>
                    <input type="number" min="1" max="15" class="tool-input-small"
                           disabled="@_spinning" @bind="_drawCount" />
                </label>
            </div>
        }

        <div class="wheel-labels @(_weighted ? "is-weighted" : "")">
            @for (int i = 0; i < items.Count; i++)
            {
                var idx = i;
                <div class="wheel-label-row">
                    <input class="tool-input wheel-label-input"
                           value="@items[idx].Label"
                           disabled="@_spinning"
                           @oninput="e => OnLabelInput(e, idx)"
                           placeholder="@items[idx].Placeholder" />
                    @if (_weighted)
                    {
                        <input type="number" min="1" max="99" step="1"
                               class="tool-input wheel-weight-input"
                               value="@items[idx].Weight"
                               disabled="@_spinning"
                               @oninput="e => OnWeightInput(e, idx)"
                               title="@Loc["wheel.weight.title"]" />
                    }
                    @if (_images && items[idx].HasImage)
                    {
                        <button type="button" class="wheel-img-clear" disabled="@_spinning"
                                @onclick="() => ClearImage(idx)"
                                title="@($"{items[idx].ImageFileName} - {Loc["wheel.imageClearTitle"]}")">
                            <i class="bi bi-image"></i><i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="wheel-presets">
            <span class="wheel-section-label">@Loc["wheel.presets"]</span>
            <div class="wheel-chip-row">
                <button class="wheel-preset-chip" disabled="@_spinning"
                        @onclick='() => ApplyPreset(new[] { Loc["wheel.preset.yes"], Loc["wheel.preset.no"] })'>@Loc["wheel.preset.yesno"]</button>
                <button class="wheel-preset-chip" disabled="@_spinning"
                        @onclick='() => ApplyPreset(new[] { Loc["wheel.preset.heads"], Loc["wheel.preset.tails"] })'>@Loc["wheel.preset.coin"]</button>
                <button class="wheel-preset-chip" disabled="@_spinning" @onclick="() => ApplyPreset(NumberRange(6))">1-6</button>
                <button class="wheel-preset-chip" disabled="@_spinning" @onclick="() => ApplyPreset(NumberRange(10))">1-10</button>
            </div>
        </div>

        <div class="wheel-saved">
            <span class="wheel-section-label">@Loc["wheel.saved"]</span>
            <div class="wheel-save-row">
                <input class="tool-input" placeholder="@Loc["wheel.savePlaceholder"]"
                       @bind="_saveName" @bind:event="oninput" disabled="@_spinning" />
                <button class="sh-mini-btn" @onclick="SaveCurrent"
                        disabled="@(_spinning || string.IsNullOrWhiteSpace(_saveName) || !CanSave)">
                    <i class="bi bi-bookmark-plus"></i> @Loc["wheel.save"]
                </button>
            </div>
            @if (_saved.Count > 0)
            {
                <div class="wheel-chip-row">
                    @foreach (var w in _saved)
                    {
                        var saved = w;
                        <span class="wheel-saved-chip">
                            <button class="wheel-saved-load" disabled="@_spinning"
                                    @onclick="() => ApplySaved(saved)" title="@Loc["wheel.loadTitle"]">@saved.Name</button>
                            <button class="wheel-saved-del" @onclick="() => DeleteSaved(saved)" title="@Loc["wheel.deleteTitle"]">
                                <i class="bi bi-x"></i>
                            </button>
                        </span>
                    }
                </div>
            }
        </div>

        @if (_history.Count > 0)
        {
            <div class="wheel-history">
                <div class="wheel-history-head">
                    <span>@Loc["wheel.history"]</span>
                    <button type="button" class="wheel-clear-btn" @onclick="ClearHistory">@Loc["wheel.clear"]</button>
                </div>
                <div class="wheel-history-list">
                    @foreach (var h in _history)
                    {
                        <span class="wheel-history-chip">@h</span>
                    }
                </div>
            </div>
        }
    </div>

</div>

@code {
    private string rawCountInput = "6";
    private int? _count = 6;
    private int? count
    {
        get => _count;
        set
        {
            if (value.HasValue)
            {
                int newValue = Math.Clamp(value.Value, 2, 16);
                if (_count != newValue)
                {
                    _count = newValue;
                    InitItems();
                    ClearResult();
                    InvokeAsync(RenderWheel);
                }
            }
            else
            {
                _count = null;
            }
        }
    }

    private List<WheelItem> items = new();
    private string selectedResult = "";
    private string _question = "";
    private string? _goatLine;    // replaces the question after a Messi win
    private bool _images;
    private int _nextId;
    private DotNetObjectReference<Wheel>? _objRef;
    private bool _spinning;
    private bool _eliminate;
    private bool _weighted;
    private bool _raffle;
    private int _drawCount = 2;
    private readonly List<string> _winners = new();
    private string _saveName = "";
    private List<SavedWheel> _saved = new();
    private const string SavedKey = "wheel.saved";
    private int _spinCount;
    private readonly List<string> _history = new();

    // deep-link presets (e.g. the Discord bot's "spin it live" link)
    [Parameter, SupplyParameterFromQuery] public string? Options { get; set; }
    [Parameter, SupplyParameterFromQuery] public bool Go { get; set; }
    private bool _autoSpin;

    // a slice counts as filled when it has a label or an image
    private bool CanSpin =>
        !_spinning &&
        items.Count >= 2 &&
        items.All(i => !string.IsNullOrWhiteSpace(i.Label) || (_images && i.HasImage));

    // saving needs at least two filled labels, but tolerates blank ones
    private bool CanSave => items.Count(i => !string.IsNullOrWhiteSpace(i.Label)) >= 2;

    private string SpinLabel =>
        _spinning ? Loc["wheel.spinning"]
        : _raffle ? $"{Loc["wheel.drawBtn"]} {Math.Clamp(_drawCount, 1, Math.Max(1, items.Count - 1))}"
        : Loc["wheel.spinBtn"];

    protected override void OnInitialized()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        InitItems();
        ApplyQuery();
    }

    // preset the wheel labels (and optionally auto-spin) from a deep link
    private void ApplyQuery()
    {
        if (string.IsNullOrWhiteSpace(Options)) return;
        var labels = Options
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(16).ToList();
        if (labels.Count < 2) return;

        _count = labels.Count;
        rawCountInput = labels.Count.ToString();
        InitItems();
        for (int i = 0; i < labels.Count && i < items.Count; i++)
            items[i].Label = labels[i];
        _autoSpin = Go;
    }

    private void OnLanguageChanged()
    {
        // refresh placeholders so "Option N" tracks the active language
        InitItems();
        InvokeAsync(StateHasChanged);
        _ = RenderWheel();
    }

    public void Dispose()
    {
        Loc.LanguageChanged -= OnLanguageChanged;
        _objRef?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // drop image state left over from a previous visit (slice ids restart at 0)
            await JS.InvokeVoidAsync("wheelImages.reset");
            await RenderWheel();
            await LoadSaved();
            StateHasChanged();
            if (_autoSpin && CanSpin)
            {
                _autoSpin = false;
                await SpinWheel();
            }
        }
    }

    private void HandleInput(ChangeEventArgs e)
    {
        rawCountInput = e.Value?.ToString() ?? string.Empty;

        if (int.TryParse(rawCountInput, out int parsed) && parsed >= 2 && parsed <= 16)
        {
            count = parsed;
        }
    }

    private void HandleBlur()
    {
        if (int.TryParse(rawCountInput, out int parsed))
        {
            count = parsed;
        }
        else
        {
            count = 2;
        }

        // reflect the clamped value back
        rawCountInput = (_count ?? 2).ToString();
    }

    private void InitItems()
    {
        var current = items;
        int n = _count ?? 2;

        // keep each slice's identity (and thus its JS-side image) across resizes
        items = Enumerable.Range(1, n)
            .Select(i =>
            {
                var old = current.ElementAtOrDefault(i - 1);
                return new WheelItem
                {
                    Id = old?.Id ?? _nextId++,
                    Label = old?.Label ?? string.Empty,
                    Weight = old?.Weight ?? 1,
                    HasImage = old?.HasImage ?? false,
                    ImageFileName = old?.ImageFileName,
                    Placeholder = $"{Loc["wheel.option"]} {i}"
                };
            })
            .ToList();
    }

    // labels + effective weights for the canvas; weights collapse to 1 when the toggle is off
    private object[] WheelPayload() =>
        items.Select(i => (object)new { id = i.Id, label = i.Label, weight = _weighted ? i.Weight : 1.0 }).ToArray();

    private async Task RenderWheel()
    {
        await JS.InvokeVoidAsync("renderWheel", new object[] { WheelPayload() });
    }

    private async Task SpinWheel()
    {
        if (!CanSpin)
            return;

        if (_raffle)
        {
            await Draw();
            return;
        }

        _spinning = true;
        ClearResult();
        StateHasChanged();

        int winner = await SpinOnce();
        if (winner >= 0 && winner < items.Count)
        {
            selectedResult = DisplayLabel(items[winner]);
            if (IsMessi(items[winner])) _goatLine = RandomGoatLine();
            _spinCount++;
            AddHistory(selectedResult);
            StateHasChanged();

            // elimination mode: drop winner, keep at least 2
            if (_eliminate && items.Count > 2)
            {
                RemoveWinner(winner);
                await RenderWheel();
            }
        }

        _spinning = false;
        StateHasChanged();
    }

    // raffle: spin repeatedly, removing each winner, until we've drawn the target count
    private async Task Draw()
    {
        ClearResult();
        _spinning = true;
        StateHasChanged();

        int target = Math.Clamp(_drawCount, 1, Math.Max(1, items.Count - 1));
        for (int k = 0; k < target && items.Count >= 2; k++)
        {
            int winner = await SpinOnce();
            if (winner < 0 || winner >= items.Count) break;

            var label = DisplayLabel(items[winner]);
            if (IsMessi(items[winner])) _goatLine = RandomGoatLine();
            _winners.Add(label);
            AddHistory(label);
            RemoveWinner(winner);
            await RenderWheel();
            StateHasChanged();
        }

        _spinning = false;
        StateHasChanged();
    }

    // one animated spin; counts the stat and celebrates a valid landing
    private async Task<int> SpinOnce()
    {
        int winner = await JS.InvokeAsync<int>("spinWheel", new object?[] { WheelPayload(), PickRiggedIndex() });
        if (winner >= 0 && winner < items.Count)
        {
            Stats.Increment("wheel");
            await JS.InvokeVoidAsync("celebrate");
        }
        return winner;
    }

    // --- the Messi clause 🐐 ---
    // any slice mentioning messi (label or image filename) always wins

    private bool IsMessi(WheelItem i) =>
        i.Label.Contains("messi", StringComparison.OrdinalIgnoreCase) ||
        (_images && i.HasImage &&
         (i.ImageFileName?.Contains("messi", StringComparison.OrdinalIgnoreCase) ?? false));

    private int? PickRiggedIndex()
    {
        var goats = Enumerable.Range(0, items.Count).Where(i => IsMessi(items[i])).ToList();
        return goats.Count == 0 ? null : goats[Random.Shared.Next(goats.Count)];
    }

    private static readonly string[] GoatLines =
    {
        "No question. Messi is the BEST! 🐐",
        "The wheel never had a choice. MESSI.",
        "GOAT detected. Question irrelevant.",
        "It was always going to be Messi.",
        "ANKARA MESSI, MESSI, MESSI!"
    };

    private static string RandomGoatLine() => GoatLines[Random.Shared.Next(GoatLines.Length)];

    // what the result card shows; image-only slices fall back to the filename
    private string DisplayLabel(WheelItem i)
    {
        if (!string.IsNullOrWhiteSpace(i.Label)) return i.Label;
        var name = i.ImageFileName;
        if (string.IsNullOrWhiteSpace(name)) return i.Placeholder;
        int dot = name.LastIndexOf('.');
        return dot > 0 ? name[..dot] : name;
    }

    // drop a slice and renumber the remaining placeholders
    private void RemoveWinner(int idx)
    {
        items.RemoveAt(idx);
        _count = items.Count;
        rawCountInput = items.Count.ToString();
        for (int i = 0; i < items.Count; i++)
            items[i].Placeholder = $"{Loc["wheel.option"]} {i + 1}";
    }

    private void AddHistory(string label)
    {
        _history.Insert(0, label);
        if (_history.Count > 8)
            _history.RemoveAt(_history.Count - 1);
    }

    private Task ToggleRaffle()
    {
        _raffle = !_raffle;
        ClearResult();
        return Task.CompletedTask;
    }

    private async Task OnLabelInput(ChangeEventArgs e, int index)
    {
        if (index < 0 || index >= items.Count)
            return;

        items[index].Label = e.Value?.ToString() ?? string.Empty;
        ClearResult();
        await RenderWheel();
    }

    private async Task OnWeightInput(ChangeEventArgs e, int index)
    {
        if (index < 0 || index >= items.Count)
            return;

        items[index].Weight = double.TryParse(e.Value?.ToString(), out var w)
            ? Math.Clamp(w, 1, 99)
            : 1;
        ClearResult();
        await RenderWheel();
    }

    private Task ToggleWeighted()
    {
        _weighted = !_weighted;
        ClearResult();
        return RenderWheel();
    }

    // --- slice images (bitmaps live in wheel.js, keyed by WheelItem.Id) ---

    // in image mode the canvas is for picking/adjusting images; spin via the button
    private Task OnCanvasClick() => _images ? Task.CompletedTask : SpinWheel();

    private async Task ToggleImages()
    {
        _images = !_images;
        _objRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("wheelImages.setEnabled", _images, _objRef);
    }

    private async Task ClearImage(int idx)
    {
        if (idx < 0 || idx >= items.Count) return;
        items[idx].HasImage = false;
        items[idx].ImageFileName = null;
        await JS.InvokeVoidAsync("wheelImages.clear", items[idx].Id);
    }

    [JSInvokable]
    public void OnSliceImageChanged(int id, string? fileName)
    {
        var item = items.FirstOrDefault(i => i.Id == id);
        if (item is null) return;
        item.HasImage = fileName != null;
        item.ImageFileName = fileName;
        InvokeAsync(StateHasChanged);
    }

    // --- presets & saved wheels ---

    private static string[] NumberRange(int n) =>
        Enumerable.Range(1, n).Select(i => i.ToString()).ToArray();

    private Task ApplyPreset(string[] labels) =>
        LoadItems(labels.Select(l => (l, 1.0)).ToList());

    private Task ApplySaved(SavedWheel w)
    {
        _question = w.Question ?? "";
        return LoadItems(w.Items.Select(s => (s.Label, s.Weight)).ToList());
    }

    // fill the wheel from a label/weight set, resizing to fit (clamped 2..16)
    private async Task LoadItems(List<(string Label, double Weight)> data)
    {
        int n = Math.Clamp(data.Count, 2, 16);
        _count = n;
        rawCountInput = n.ToString();
        InitItems();
        for (int i = 0; i < n && i < items.Count; i++)
        {
            items[i].Label = data[i].Label;
            items[i].Weight = data[i].Weight <= 0 ? 1 : data[i].Weight;
        }
        if (data.Take(n).Any(d => d.Weight != 1)) _weighted = true;   // reveal weights if any differ
        ClearResult();
        await RenderWheel();
    }

    private async Task SaveCurrent()
    {
        var name = _saveName.Trim();
        var slices = items
            .Where(i => !string.IsNullOrWhiteSpace(i.Label))
            .Select(i => new SavedSlice { Label = i.Label, Weight = i.Weight })
            .ToList();
        if (name.Length == 0 || slices.Count < 2) return;

        _saved.RemoveAll(w => string.Equals(w.Name, name, StringComparison.OrdinalIgnoreCase));
        _saved.Insert(0, new SavedWheel { Name = name, Items = slices, Question = _question.Trim() });
        if (_saved.Count > 12) _saved.RemoveRange(12, _saved.Count - 12);
        _saveName = "";
        await PersistSaved();
    }

    private async Task DeleteSaved(SavedWheel w)
    {
        _saved.Remove(w);
        await PersistSaved();
    }

    private async Task LoadSaved()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", SavedKey);
            if (!string.IsNullOrWhiteSpace(json))
                _saved = System.Text.Json.JsonSerializer.Deserialize<List<SavedWheel>>(json) ?? new();
        }
        catch { _saved = new(); }
    }

    private async Task PersistSaved()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_saved);
            await JS.InvokeVoidAsync("localStorage.setItem", SavedKey, json);
        }
        catch { /* storage blocked - keep in-memory copy */ }
    }

    private void ClearHistory() => _history.Clear();

    private void ClearResult()
    {
        selectedResult = "";
        _winners.Clear();
        _goatLine = null;
    }

    // serialized to localStorage under SavedKey
    private class SavedWheel
    {
        public string Name { get; set; } = "";
        public string? Question { get; set; }
        public List<SavedSlice> Items { get; set; } = new();
    }

    private class SavedSlice
    {
        public string Label { get; set; } = "";
        public double Weight { get; set; } = 1;
    }
}
