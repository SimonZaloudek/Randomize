@page "/wheel"
@using Randomize.Core.Wheel
@inject IJSRuntime JS

<h2 class="page-title">Spinning Wheel</h2>

<div class="wheel-layout">

    <div class="wheel-stage">
        <canvas id="wheelCanvas" class="wheel-canvas" width="320" height="320"></canvas>

        <button class="tool-btn wheel-spin-btn" @onclick="SpinWheel" disabled="@(!CanSpin)">
            @(_spinning ? "Spinning…" : "🎯 Spin")
        </button>

        @if (!string.IsNullOrEmpty(selectedResult))
        {
            <div class="wheel-result" @key="_spinCount">
                <span class="wheel-result-label">Winner</span>
                <span class="wheel-result-value">🎉 @selectedResult</span>
            </div>
        }
    </div>

    <div class="wheel-panel tool-card">
        <div class="option-row">
            <label>
                <span class="opt-key">Options:</span>
                <input type="number" min="2" max="16" class="tool-input-small"
                       disabled="@_spinning"
                       @bind-value="rawCountInput" @oninput="HandleInput" @onblur="HandleBlur" />
            </label>
        </div>

        <div class="option-row option-row-wrap">
            <label>
                <input type="checkbox" @bind="_eliminate" disabled="@_spinning" />
                Remove the winner after each spin
            </label>
        </div>

        <div class="wheel-labels">
            @for (int i = 0; i < items.Count; i++)
            {
                var idx = i;
                <input class="tool-input wheel-label-input"
                       value="@items[idx].Label"
                       disabled="@_spinning"
                       @oninput="e => OnLabelInput(e, idx)"
                       placeholder="@items[idx].Placeholder" />
            }
        </div>

        @if (_history.Count > 0)
        {
            <div class="wheel-history">
                <div class="wheel-history-head">
                    <span>History</span>
                    <button type="button" class="wheel-clear-btn" @onclick="ClearHistory">Clear</button>
                </div>
                <div class="wheel-history-list">
                    @foreach (var h in _history)
                    {
                        <span class="wheel-history-chip">@h</span>
                    }
                </div>
            </div>
        }
    </div>

</div>

@code {
    private string rawCountInput = "6";
    private int? _count = 6;
    private int? count
    {
        get => _count;
        set
        {
            if (value.HasValue)
            {
                int newValue = Math.Clamp(value.Value, 2, 16);
                if (_count != newValue)
                {
                    _count = newValue;
                    InitItems();
                    ClearResult();
                    InvokeAsync(RenderWheel);
                }
            }
            else
            {
                _count = null;
            }
        }
    }

    private List<WheelItem> items = new();
    private string selectedResult = "";
    private bool _spinning;
    private bool _eliminate;
    private int _spinCount;
    private readonly List<string> _history = new();

    private bool CanSpin =>
        !_spinning &&
        items.Count >= 2 &&
        items.All(i => !string.IsNullOrWhiteSpace(i.Label));

    protected override void OnInitialized()
    {
        InitItems();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderWheel();
        }
    }

    private void HandleInput(ChangeEventArgs e)
    {
        rawCountInput = e.Value?.ToString() ?? string.Empty;

        if (int.TryParse(rawCountInput, out int parsed) && parsed >= 2 && parsed <= 16)
        {
            count = parsed;
        }
    }

    private void HandleBlur()
    {
        if (int.TryParse(rawCountInput, out int parsed))
        {
            count = parsed;
        }
        else
        {
            count = 2;
        }

        // Reflect the clamped value back into the textbox.
        rawCountInput = (_count ?? 2).ToString();
    }

    private void InitItems()
    {
        var current = items;
        int n = _count ?? 2;

        items = Enumerable.Range(1, n)
            .Select(i => new WheelItem
            {
                Label = current.ElementAtOrDefault(i - 1)?.Label ?? string.Empty,
                Placeholder = $"Option {i}"
            })
            .ToList();
    }

    private async Task RenderWheel()
    {
        await JS.InvokeVoidAsync("renderWheel", items.Select(i => i.Label));
    }

    private async Task SpinWheel()
    {
        if (!CanSpin)
            return;

        _spinning = true;
        selectedResult = "";
        StateHasChanged();

        int winner = await JS.InvokeAsync<int>("spinWheel", items.Select(i => i.Label));

        if (winner >= 0 && winner < items.Count)
        {
            selectedResult = items[winner].Label;
            _spinCount++;
            _history.Insert(0, selectedResult);
            if (_history.Count > 8)
                _history.RemoveAt(_history.Count - 1);
            StateHasChanged();

            await JS.InvokeVoidAsync("celebrate");

            // Elimination mode: drop the winner, but never below 2 slices.
            if (_eliminate && items.Count > 2)
            {
                items.RemoveAt(winner);
                _count = items.Count;
                rawCountInput = items.Count.ToString();
                for (int i = 0; i < items.Count; i++)
                    items[i].Placeholder = $"Option {i + 1}";
                await RenderWheel();
            }
        }

        _spinning = false;
        StateHasChanged();
    }

    private async Task OnLabelInput(ChangeEventArgs e, int index)
    {
        if (index < 0 || index >= items.Count)
            return;

        items[index].Label = e.Value?.ToString() ?? string.Empty;
        ClearResult();
        await RenderWheel();
    }

    private void ClearHistory() => _history.Clear();

    private void ClearResult() => selectedResult = "";
}
