@page "/gamers"
@using Randomize.Web.Services
@inject LocalizationService Loc
@implements IDisposable

<PageTitle>@Loc["gamers.title"]</PageTitle>

<h2 class="page-title">@Loc["gamers.title"]</h2>

<div class="home-feature-grid">
    <NavLink href="/lol" class="home-feature-card">
        <div class="home-feature-icon"><i class="bi bi-joystick"></i></div>
        <div class="home-feature-title">League of Legends</div>
        <div class="home-feature-desc">Ultimate chaos: random champion, runes, items and a full challenge build.</div>
        <i class="bi bi-arrow-right home-feature-arrow"></i>
    </NavLink>

    <div class="home-feature-card home-feature-card-soon">
        <div class="home-feature-icon home-feature-icon-soon"><i class="bi bi-stars"></i></div>
        <div class="home-feature-title">More games soon</div>
        <div class="home-feature-desc">Other titles are on the way.</div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Loc.LanguageChanged += OnLanguageChanged;

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Loc.LanguageChanged -= OnLanguageChanged;
}
