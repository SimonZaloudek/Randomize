@page "/groupshuffler"
@using Randomize.Core.Services
@using Randomize.Web.Services
@inject IJSRuntime JS
@inject StatsClient Stats
@inject LocalizationService Loc
@implements IDisposable

<h2 class="page-title">@Loc["group.title"]</h2>

<div class="shuffler">

    <div class="shuffler-top">

        <!-- Step 1: the names input -->
        <section class="sh-card sh-input">
            <div class="sh-card-head">
                <span class="sh-step">1</span>
                <h3 class="sh-card-title">@Loc["group.step.names"]</h3>
                <span class="sh-count">@_count @(_count == 1 ? Loc["group.summary.person"] : Loc["group.summary.people"])</span>
            </div>

            <LinedTextarea @bind-Value="input" Placeholder="@Loc["group.placeholder"]" MinRows="10" />

            <div class="sh-input-actions">
                <button class="sh-mini-btn" @onclick="PasteFromClipboard">
                    <i class="bi bi-clipboard"></i> @Loc["group.paste"]
                </button>
                <button class="sh-mini-btn" @onclick="LoadExample">
                    <i class="bi bi-people"></i> @Loc["group.example"]
                </button>
            </div>
        </section>

        <!-- Step 2: shuffle options -->
        <section class="sh-card sh-options">
            <div class="sh-card-head">
                <span class="sh-step">2</span>
                <h3 class="sh-card-title">@Loc["group.step.options"]</h3>
            </div>

            <div class="sh-field">
                <span class="sh-label">@Loc["group.mode.label"]</span>
                <div class="sh-mode">
                    <button class="sh-mode-btn @(_mode == ShuffleMode.GroupCount ? "active" : "")"
                            @onclick="@(() => _mode = ShuffleMode.GroupCount)">
                        <i class="bi bi-grid-3x3-gap-fill"></i> @Loc["group.mode.count"]
                    </button>
                    <button class="sh-mode-btn @(_mode == ShuffleMode.GroupSize ? "active" : "")"
                            @onclick="@(() => _mode = ShuffleMode.GroupSize)">
                        <i class="bi bi-person-fill"></i> @Loc["group.mode.size"]
                    </button>
                </div>
            </div>

            <div class="sh-field">
                <span class="sh-label">@(_mode == ShuffleMode.GroupCount ? Loc["group.count"] : Loc["group.size"])</span>
                <div class="sh-stepper">
                    <button class="sh-step-btn" @onclick="() => Step(-1)" disabled="@(_groupCount <= 1)" aria-label="@Loc["group.stepper.dec"]">−</button>
                    <span class="sh-step-val">@_groupCount</span>
                    <button class="sh-step-btn" @onclick="() => Step(1)" disabled="@(_groupCount >= 15)" aria-label="@Loc["group.stepper.inc"]">+</button>
                </div>
            </div>

            @if (_mode == ShuffleMode.GroupSize)
            {
                <div class="sh-field">
                    <span class="sh-label">@Loc["group.balance.label"]</span>
                    <select class="sh-balance" @bind="_balance">
                        <option value="even">@Loc["group.balance.even"]</option>
                        <option value="exact">@Loc["group.balance.exact"]</option>
                    </select>
                </div>
            }

            <label class="sh-toggle">
                <input type="checkbox" @bind="_keepOrder" />
                <span class="sh-toggle-track"><span class="sh-toggle-thumb"></span></span>
                <span class="sh-toggle-text">
                    <strong>@Loc["group.keepOrder"]</strong>
                    <small>@Loc["group.keepOrder.hint"]</small>
                </span>
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="shuffler-error" role="alert">@_error</div>
            }

            <button class="sh-shuffle" @onclick="Shuffle">
                <i class="bi bi-shuffle"></i> @Loc["group.btn"]
            </button>
        </section>

    </div>

    @if (groups.Count > 0)
    {
        <div class="shuffler-result">
            <div class="shuffler-summary">
                <span>
                    @Loc["group.summary.shuffled"] <strong>@_lastInputCount</strong>
                    @(_lastInputCount == 1 ? Loc["group.summary.person"] : Loc["group.summary.people"]) @Loc["group.summary.into"]
                    <strong>@groups.Count</strong> @(groups.Count == 1 ? Loc["group.summary.group"] : Loc["group.summary.groups"])
                </span>
                <div class="shuffler-summary-actions">
                    <button class="shuffler-action" @onclick="Shuffle" title="@Loc["group.action.reshuffleTitle"]">@Loc["group.action.reshuffle"]</button>
                    <button class="shuffler-action" @onclick="CopyAll" title="@Loc["group.action.copyAllTitle"]">
                        @(_copiedAll ? Loc["group.action.copied"] : Loc["group.action.copyAll"])
                    </button>
                </div>
            </div>

            <div class="group-grid">
                @for (int gi = 0; gi < groups.Count; gi++)
                {
                    var groupIdx = gi;
                    var accent = AccentForGroup(gi);
                    <div class="group-card @(_dragOverGroup == groupIdx ? "group-card-droptarget" : "")"
                         @key="@($"{_shuffleId}-{groupIdx}")"
                         style="--group-accent:@accent; --i:@gi"
                         ondragover="event.preventDefault(); event.dataTransfer.dropEffect='move';"
                         @ondragenter="@(() => OnDragEnter(groupIdx))"
                         @ondrop="@(() => OnDrop(groupIdx))"
                         @ondrop:preventDefault="true">
                        <div class="group-card-head">
                            <input class="group-title-input"
                                   @bind="groups[groupIdx].Name"
                                   @bind:event="oninput"
                                   aria-label="@Loc["group.card.nameAria"]" />
                            <span class="group-size" title="@Loc["group.card.membersTitle"]">@groups[groupIdx].Members.Count</span>
                            <button class="group-copy-btn"
                                    @onclick="@(() => CopyGroup(groupIdx))"
                                    title="@Loc["group.card.copyTitle"]">
                                @(_copiedGroup == groupIdx ? Loc["group.action.copied"] : Loc["group.card.copy"])
                            </button>
                        </div>
                        <ul class="group-list">
                            @for (int pi = 0; pi < groups[groupIdx].Members.Count; pi++)
                            {
                                var personIdx = pi;
                                <li class="group-item"
                                    draggable="true"
                                    @ondragstart="@(() => OnDragStart(groupIdx, personIdx))"
                                    @ondragend="OnDragEnd">
                                    @groups[groupIdx].Members[personIdx]
                                </li>
                            }
                            @if (groups[groupIdx].Members.Count == 0)
                            {
                                <li class="group-item-empty">@Loc["group.card.empty"]</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private enum ShuffleMode { GroupCount, GroupSize }

    private class GroupBucket
    {
        public string Name { get; set; } = "";
        public List<string> Members { get; set; } = new();
    }

    private string input = "";
    private int _groupCount = 2;
    private ShuffleMode _mode = ShuffleMode.GroupCount;
    private string _balance = "even";   // "even" = balanced sizes | "exact" = groups of N
    private bool _keepOrder;            // true = split as typed, skip the shuffle
    private string _error = "";
    private int _lastInputCount;
    private int _shuffleId;

    // live name count shown in the input card header
    private int _count => GroupShufflerCore.InputCount(input);

    private List<GroupBucket> groups = new();

    // drag state
    private int? _dragSourceGroup;
    private int? _dragSourceIndex;
    private int? _dragOverGroup;

    // "copied" feedback
    private int? _copiedGroup;
    private bool _copiedAll;

    // shared 16-colour palette
    private static readonly string[] _palette = new[]
    {
        "#ef6f6c","#f0915a","#efc05a","#d4d65f",
        "#9bd06b","#63c98d","#54c6b6","#56b4d3",
        "#5b93d6","#6f7fd6","#8f74d4","#aa6fd0",
        "#c66fc4","#d96fa3","#e06f86","#cf7d6a"
    };

    private static string AccentForGroup(int i) => _palette[i % _palette.Length];

    protected override void OnInitialized()
    {
        Loc.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Loc.LanguageChanged -= OnLanguageChanged;

    // stepper: nudge the group count/size, kept within 1..15
    private void Step(int delta) => _groupCount = Math.Clamp(_groupCount + delta, 1, 15);

    private async Task PasteFromClipboard()
    {
        try
        {
            var text = await JS.InvokeAsync<string>("navigator.clipboard.readText");
            if (!string.IsNullOrWhiteSpace(text)) input = text;
        }
        catch { /* clipboard blocked or unavailable - ignore */ }
    }

    private void LoadExample() => input = string.Join("\n", new[]
    {
        "Alex", "Sam", "Jordan", "Taylor", "Casey", "Riley",
        "Morgan", "Jamie", "Avery", "Quinn", "Drew", "Skyler"
    });

    private void Shuffle()
    {
        _error = "";
        int totalPeople = GroupShufflerCore.InputCount(input);

        if (totalPeople < 2)
        {
            _error = Loc["group.error.minTwo"];
            return;
        }
        if (_groupCount < 1 || _groupCount > 15)
        {
            _error = _mode == ShuffleMode.GroupCount
                ? Loc["group.error.groupCountRange"]
                : Loc["group.error.groupSizeRange"];
            return;
        }
        if (_mode == ShuffleMode.GroupCount && _groupCount > totalPeople)
        {
            _error = Loc["group.error.exceedsPeople"];
            return;
        }

        var raw = _mode == ShuffleMode.GroupCount
            ? GroupShufflerCore.ShuffleIntoGroups(input, _groupCount, shuffle: !_keepOrder)
            : GroupShufflerCore.ShuffleIntoGroupsOfSize(input, _groupCount, shuffle: !_keepOrder, exactSize: _balance == "exact");

        // keep custom names where indices line up
        var oldNames = groups.Select(g => g.Name).ToList();
        groups = raw.Select((members, i) => new GroupBucket
        {
            Name = (i < oldNames.Count && !string.IsNullOrWhiteSpace(oldNames[i]))
                ? oldNames[i]
                : $"{Loc["group.groupName"]} {i + 1}",
            Members = members
        }).ToList();

        _lastInputCount = totalPeople;
        _shuffleId++;
        Stats.Increment("group");
    }

    private void OnDragStart(int groupIdx, int personIdx)
    {
        _dragSourceGroup = groupIdx;
        _dragSourceIndex = personIdx;
    }

    private void OnDragEnter(int groupIdx) => _dragOverGroup = groupIdx;

    private void OnDrop(int targetGroup)
    {
        if (_dragSourceGroup is int sg && _dragSourceIndex is int si
            && sg != targetGroup
            && sg >= 0 && sg < groups.Count
            && si >= 0 && si < groups[sg].Members.Count
            && targetGroup >= 0 && targetGroup < groups.Count)
        {
            var person = groups[sg].Members[si];
            groups[sg].Members.RemoveAt(si);
            groups[targetGroup].Members.Add(person);
        }
        ResetDragState();
    }

    private void OnDragEnd() => ResetDragState();

    private void ResetDragState()
    {
        _dragSourceGroup = null;
        _dragSourceIndex = null;
        _dragOverGroup = null;
    }

    private async Task CopyGroup(int idx)
    {
        if (idx < 0 || idx >= groups.Count) return;
        var text = string.Join("\n", groups[idx].Members);
        if (await TryCopy(text))
        {
            _copiedGroup = idx;
            StateHasChanged();
            await Task.Delay(1200);
            _copiedGroup = null;
            StateHasChanged();
        }
    }

    private async Task CopyAll()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var g in groups)
        {
            sb.AppendLine($"{g.Name}:");
            foreach (var m in g.Members)
                sb.AppendLine($"  {m}");
            sb.AppendLine();
        }
        if (await TryCopy(sb.ToString()))
        {
            _copiedAll = true;
            StateHasChanged();
            await Task.Delay(1200);
            _copiedAll = false;
            StateHasChanged();
        }
    }

    private async Task<bool> TryCopy(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            return true;
        }
        catch
        {
            // clipboard unavailable - skip
            return false;
        }
    }
}
