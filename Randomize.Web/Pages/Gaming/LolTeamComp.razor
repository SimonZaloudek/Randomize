@page "/lol/team"
@using System.Net.Http.Json
@using Randomize.Web.Data
@inject HttpClient Http
@inject IJSRuntime JS
@inject LocalizationService Loc
@implements IDisposable

<PageTitle>@Loc["lol.team.title"]</PageTitle>

<div class="ghub-ambient lol-shell @(_hudHidden ? "hud-hidden" : "")" style="@_bgStyle">

    <div class="lol-bg" aria-hidden="true"><div class="lol-bg-photo"></div></div>

    <div class="lol-page lol-team">

    <div class="lol-topbar">
        <NavLink href="/gamershub" class="hub-back"><i class="bi bi-arrow-left"></i> @Loc["nav.gamers"]</NavLink>
        <div class="lol-actions">
            <button class="lol-icon-btn lol-eye" title="@(_hudHidden ? Loc["lol.showHud"] : Loc["lol.hideHud"])" @onclick="ToggleHud">
                <i class="bi @(_hudHidden ? "bi-eye-slash" : "bi-eye")"></i>
            </button>
            @if (Rolled)
            {
                <button class="lol-icon-btn" title="@(_shared ? Loc["lol.shareCopied"] : Loc["lol.team.share"])" @onclick="Share">
                    <i class="bi @(_shared ? "bi-check2" : "bi-share-fill")"></i>
                </button>
                <button class="lol-icon-btn" title="@(_copied ? Loc["lol.copied"] : Loc["lol.team.copy"])" @onclick="Copy">
                    <i class="bi @(_copied ? "bi-check2" : "bi-clipboard")"></i>
                </button>
            }
        </div>
    </div>

    <header class="lol-head">
        <h2 class="page-title">@Loc["lol.team.title"]</h2>
        <p class="lol-sub">@Loc["lol.team.sub"]</p>

        <div class="lol-controls">
            <button class="lol-roll" @onclick="RollTeam" disabled="@_loading">
                <i class="bi bi-dice-5-fill"></i> @(Rolled ? Loc["lol.team.reroll"] : Loc["lol.team.roll"])
            </button>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="lol-error">@_error</div>
    }

    <div class="team-lobby">
        @for (var i = 0; i < Size; i++)
        {
            var idx = i;
            <section class="team-slot">
                @if (_champs[idx] is { } art)
                {
                    <div class="team-slot-art" style="background-image:url('https://ddragon.leagueoflegends.com/cdn/img/champion/loading/@(art.Id)_0.jpg')"></div>
                }
                <span class="lol-role team-role">@Lanes[idx]</span>

                <div class="team-champ">
                    @if (_champs[idx] is { } ch)
                    {
                        <img class="team-square" src="@ch.Square" alt="@ch.Name" />
                        <div class="team-champ-text">
                            <h3 class="team-champ-name">@ch.Name</h3>
                            <span class="team-champ-title">@ch.Title</span>
                        </div>
                    }
                    else
                    {
                        <div class="team-square team-square-empty">?</div>
                    }
                </div>

                <input class="team-name" placeholder="@Loc["lol.team.player"] @(idx + 1)" maxlength="20" @bind="_names[idx]" />

                <div class="team-actions">
                    <button class="lol-mini @(_locked[idx] ? "active" : "")" title="@(_locked[idx] ? Loc["lol.tip.unlock"] : Loc["lol.tip.lock"])"
                            @onclick="() => _locked[idx] = !_locked[idx]">
                        <i class="bi @(_locked[idx] ? "bi-lock-fill" : "bi-unlock")"></i>
                    </button>
                    <button class="lol-mini" title="@Loc["lol.tip.reroll"]" disabled="@_loading" @onclick="() => RerollSlot(idx)">
                        <i class="bi bi-dice-5"></i>
                    </button>
                </div>
            </section>
        }
    </div>
    </div>
</div>

@code {
    private const int Size = 5;
    // fixed lane per slot, in champ-select order - not shuffled
    private static readonly string[] Lanes = { "Top", "Jungle", "Mid", "Bot", "Support" };

    private readonly string[] _names = new string[Size];
    private readonly Champ?[] _champs = new Champ?[Size];
    private readonly bool[] _locked = new bool[Size];
    private bool _loading;
    private bool _copied;
    private bool _shared;
    private bool _hudHidden;
    private string? _error;
    private string? _bgStyle;

    private bool Rolled => _champs.All(c => c is not null);

    // shared-link params: c = champion ids, n = player names (each uri-escaped)
    [Parameter, SupplyParameterFromQuery(Name = "c")] public string? C { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "n")] public string? N { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        var theme = await JS.InvokeAsync<string?>("document.documentElement.getAttribute", "data-theme");
        var bg = LolBackgrounds.Random(theme);
        if (bg is not null) _bgStyle = $"--lol-bg-img:url('{bg}')";
        await (string.IsNullOrEmpty(C) ? RollTeam() : Hydrate());
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void ToggleHud() => _hudHidden = !_hudHidden;

    public void Dispose() => Loc.LanguageChanged -= OnLanguageChanged;

    private async Task RollTeam()
    {
        // locked slots that already hold a champion survive the reroll
        var open = Enumerable.Range(0, Size).Where(i => !_locked[i] || _champs[i] is null).ToList();
        if (open.Count == 0) return;

        var keep = Enumerable.Range(0, Size).Except(open).Select(i => _champs[i]!.Id);
        var res = await Fetch($"size={open.Count}&not={string.Join(",", keep)}");
        if (res is null) return;

        for (var i = 0; i < open.Count && i < res.Champions.Length; i++)
            _champs[open[i]] = res.Champions[i];
    }

    private async Task RerollSlot(int idx)
    {
        var others = _champs.Where((c, i) => i != idx && c is not null).Select(c => c!.Id);
        var res = await Fetch($"size=1&not={string.Join(",", others)}");
        if (res is null || res.Champions.Length == 0) return;
        _champs[idx] = res.Champions[0];
    }

    private async Task<TeamRes?> Fetch(string query)
    {
        if (_loading) return null;
        _loading = true;
        _copied = _shared = false;
        _error = null;
        StateHasChanged();
        try
        {
            var res = await Http.GetFromJsonAsync<TeamRes>($"api/lol/team?{query}");
            if (res is null || res.Champions.Length == 0) { _error = Loc["lol.err.noResponse"]; return null; }
            return res;
        }
        catch
        {
            _error = Loc["lol.err.unreachable"];
            return null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Hydrate()
    {
        var res = await Fetch($"c={Uri.EscapeDataString(C!)}");
        if (res is null) return;
        for (var i = 0; i < Size && i < res.Champions.Length; i++) _champs[i] = res.Champions[i];

        var names = (N ?? "").Split(',');
        for (var i = 0; i < Size && i < names.Length; i++) _names[i] = Uri.UnescapeDataString(names[i]);
    }

    private string DisplayName(int i) => string.IsNullOrWhiteSpace(_names[i]) ? $"{Loc["lol.team.player"]} {i + 1}" : _names[i].Trim();

    private async Task Share()
    {
        if (!Rolled) return;
        var q = new List<string> { $"c={string.Join(",", _champs.Select(c => c!.Id))}" };
        if (_names.Any(n => !string.IsNullOrWhiteSpace(n)))
            q.Add($"n={string.Join(",", _names.Select(n => Uri.EscapeDataString(n ?? "")))}");
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", "https://userandomize.net/lol/team?" + string.Join("&", q)); _shared = true; }
        catch { }
    }

    private async Task Copy()
    {
        if (!Rolled) return;
        var lines = Enumerable.Range(0, Size)
            .Select(i => $"{Lanes[i]}: {DisplayName(i)} - {_champs[i]!.Name}")
            .ToList();
        lines.Add("via userandomize.net/lol/team");
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join("\n", lines)); _copied = true; }
        catch { }
    }

    // --- models (match /api/lol/team output) ---
    private class TeamRes
    {
        public string? Version { get; set; }
        public Champ[] Champions { get; set; } = Array.Empty<Champ>();
    }

    private class Champ
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Title { get; set; } = "";
        public string Square { get; set; } = "";
    }
}
