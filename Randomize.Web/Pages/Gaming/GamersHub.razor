@page "/gamershub"
@using Randomize.Web.Services
@inject LocalizationService Loc
@implements IDisposable

<PageTitle>@Loc["gamers.title"]</PageTitle>

<div class="ghub">

    <!-- ambient backdrop: static perspective grid + two drifting orbs (transform/opacity only) -->
    <div class="ghub-bg" aria-hidden="true">
        <span class="ghub-grid"></span>
        <span class="ghub-orb ghub-orb-1"></span>
        <span class="ghub-orb ghub-orb-2"></span>
    </div>

    <header class="ghub-hero">
        <h1 class="page-title">@Loc["gamers.title"]</h1>
        <p class="ghub-hero-sub">@Loc["gamers.hero.sub"]</p>
    </header>

    <!-- ===== General: cross-game tools ===== -->
    <section class="ghub-section ghub-section-general">
        <div class="ghub-section-art ghub-section-art-hex" aria-hidden="true"></div>

        <div class="ghub-section-head">
            <div class="ghub-section-chip"><i class="bi bi-controller"></i></div>
            <h2 class="ghub-section-title">@Loc["gamers.general.title"]</h2>
        </div>
        <p class="ghub-section-sub">@Loc["gamers.general.sub"]</p>

        <div class="ghub-card-grid">
            <NavLink href="/games" class="ghub-card ghub-card-feature">
                <div class="ghub-card-glyph"><i class="bi bi-shuffle"></i></div>
                <div class="ghub-card-body">
                    <h3 class="ghub-card-title">@Loc["nav.games"]</h3>
                    <p class="ghub-card-desc">@Loc["home.feature.games.desc"]</p>
                </div>
                <span class="ghub-card-cta">@Loc["gamers.cta.open"] <i class="bi bi-arrow-right"></i></span>
            </NavLink>

            <NavLink href="/challenge" class="ghub-card ghub-card-feature">
                <div class="ghub-card-glyph"><i class="bi bi-lightning-charge-fill"></i></div>
                <div class="ghub-card-body">
                    <h3 class="ghub-card-title">@Loc["challenge.title"]</h3>
                    <p class="ghub-card-desc">@Loc["gamers.card.challenge.desc"]</p>
                </div>
                <span class="ghub-card-cta">@Loc["gamers.cta.open"] <i class="bi bi-arrow-right"></i></span>
            </NavLink>
        </div>
    </section>

    <!-- ===== League of Legends ===== -->
    <section class="ghub-section ghub-section-lol">
        <div class="ghub-section-art ghub-section-art-img" aria-hidden="true"></div>

        <div class="ghub-section-head">
            <div class="ghub-section-chip ghub-section-chip-lol">
                <span class="ghub-logo ghub-logo-lol"></span>
            </div>
            <h2 class="ghub-section-title">@Loc["gamers.lol.title"]</h2>
        </div>
        <p class="ghub-section-sub">@Loc["gamers.lol.sub"]</p>

        <div class="ghub-card-grid">
            <NavLink href="/lol" class="ghub-card ghub-card-feature">
                <div class="ghub-card-glyph"><i class="bi bi-dice-5-fill"></i></div>
                <div class="ghub-card-body">
                    <h3 class="ghub-card-title">@Loc["gamers.card.bravery.title"]</h3>
                    <p class="ghub-card-desc">@Loc["gamers.card.bravery.desc"]</p>
                </div>
                <span class="ghub-card-cta">@Loc["gamers.cta.play"] <i class="bi bi-arrow-right"></i></span>
            </NavLink>

            <NavLink href="/lol/team" class="ghub-card ghub-card-feature">
                <div class="ghub-card-glyph"><i class="bi bi-people-fill"></i></div>
                <div class="ghub-card-body">
                    <h3 class="ghub-card-title">@Loc["gamers.card.team.title"]</h3>
                    <p class="ghub-card-desc">@Loc["gamers.card.team.desc"]</p>
                </div>
                <span class="ghub-card-cta">@Loc["gamers.cta.play"] <i class="bi bi-arrow-right"></i></span>
            </NavLink>
        </div>
    </section>

    <!-- ===== Scaffold: clone this block for the next game. For now it routes to
         contact so players can request the next title to get a randomizer. ===== -->
    <section class="ghub-section ghub-section-next">
        <div class="ghub-section-head">
            <div class="ghub-section-chip"><i class="bi bi-plus-lg"></i></div>
            <h2 class="ghub-section-title">@Loc["gamers.next.title"]</h2>
        </div>
        <p class="ghub-section-sub">@Loc["gamers.next.sub"]</p>

        <div class="ghub-card-grid">
            <NavLink href="/contact" class="ghub-card ghub-card-feature">
                <div class="ghub-card-glyph"><i class="bi bi-chat-heart-fill"></i></div>
                <div class="ghub-card-body">
                    <h3 class="ghub-card-title">@Loc["gamers.card.request.title"]</h3>
                    <p class="ghub-card-desc">@Loc["gamers.card.request.desc"]</p>
                </div>
                <span class="ghub-card-cta">@Loc["gamers.cta.suggest"] <i class="bi bi-arrow-right"></i></span>
            </NavLink>
        </div>
    </section>
</div>

@code {
    protected override void OnInitialized() => Loc.LanguageChanged += OnLanguageChanged;

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Loc.LanguageChanged -= OnLanguageChanged;
}
