@page "/"
@using Randomize.Web.Services
@inject StatsClient Stats
@inject LocalizationService Loc
@implements IDisposable

<PageTitle>@Loc["nav.home"]</PageTitle>

<div class="home-page">
    <div class="home-bg" aria-hidden="true">
        <svg class="home-waves" viewBox="0 0 1600 900" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
