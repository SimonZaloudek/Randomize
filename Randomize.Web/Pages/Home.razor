                    <stop offset="55%" stop-color="#6a4dd0" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#6a4dd0" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="home-wave-r" x1="100%" y1="0%" x2="0%" y2="0%">
                    <stop offset="0%" stop-color="#8a6bff" stop-opacity="0.65" />
                    <stop offset="55%" stop-color="#6a4dd0" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#6a4dd0" stop-opacity="0" />
                </linearGradient>
            </defs>
            <g fill="none" stroke-linecap="round">
                <g stroke="url(#home-wave-l)">
                    <path stroke-width="0.5" stroke-opacity="0.45" d="M0,310 C120,290 240,330 360,300" />
                    <path stroke-width="0.8" stroke-opacity="0.7"  d="M0,360 C200,330 380,400 580,360" />
                    <path stroke-width="0.4" stroke-opacity="0.3"  d="M0,400 C140,420 280,390 420,420" />
                    <path stroke-width="1.4" stroke-opacity="0.55" d="M0,450 C240,410 460,490 720,450" />
                    <path stroke-width="0.6" stroke-opacity="0.55" d="M0,500 C160,530 320,490 500,520" />
                    <path stroke-width="1.0" stroke-opacity="0.9"  d="M0,545 C220,580 440,540 660,580" />
                    <path stroke-width="0.5" stroke-opacity="0.35" d="M0,590 C160,610 320,590 480,610" />
                    <path stroke-width="1.8" stroke-opacity="0.4"  d="M0,640 C260,680 480,640 740,690" />
                    <path stroke-width="0.7" stroke-opacity="0.6"  d="M0,690 C180,720 360,700 540,720" />
                    <path stroke-width="0.5" stroke-opacity="0.25" d="M0,740 C140,770 280,750 420,780" />
                </g>
                <g stroke="url(#home-wave-r)">
                    <path stroke-width="0.5" stroke-opacity="0.45" d="M1600,310 C1480,290 1360,330 1240,300" />
                    <path stroke-width="0.8" stroke-opacity="0.7"  d="M1600,360 C1400,330 1220,400 1020,360" />
                    <path stroke-width="0.4" stroke-opacity="0.3"  d="M1600,400 C1460,420 1320,390 1180,420" />
                    <path stroke-width="1.4" stroke-opacity="0.55" d="M1600,450 C1360,410 1140,490 880,450" />
                    <path stroke-width="0.6" stroke-opacity="0.55" d="M1600,500 C1440,530 1280,490 1100,520" />
                    <path stroke-width="1.0" stroke-opacity="0.9"  d="M1600,545 C1380,580 1160,540 940,580" />
                    <path stroke-width="0.5" stroke-opacity="0.35" d="M1600,590 C1440,610 1280,590 1120,610" />
                    <path stroke-width="1.8" stroke-opacity="0.4"  d="M1600,640 C1340,680 1120,640 860,690" />
                    <path stroke-width="0.7" stroke-opacity="0.6"  d="M1600,690 C1420,720 1240,700 1060,720" />
                    <path stroke-width="0.5" stroke-opacity="0.25" d="M1600,740 C1460,770 1320,750 1180,780" />
                </g>
            </g>
        </svg>

        <span class="home-shoot home-shoot-l1"></span>
        <span class="home-shoot home-shoot-l2"></span>
        <span class="home-shoot home-shoot-r1"></span>
        <span class="home-shoot home-shoot-r2"></span>

        <span class="home-particle" style="top: 22%; left: 9%; animation-delay: 0s;"></span>
        <span class="home-particle" style="top: 56%; left: 7%; animation-delay: 3.2s;"></span>
        <span class="home-particle" style="top: 30%; right: 9%; animation-delay: 1.6s;"></span>
        <span class="home-particle" style="top: 62%; right: 7%; animation-delay: 4.6s;"></span>
    </div>

    <div class="home-hero">
        <img src="brand/randlogofull3.png" alt="Randomize" class="home-hero-img" />
    </div>

    <div class="home-feature-grid">
        <NavLink href="/string" class="home-feature-card">
            <div class="home-feature-icon home-feature-icon-text">Aa</div>
            <div class="home-feature-title">@Loc["home.feature.text.title"]</div>
            <div class="home-feature-desc">@Loc["home.feature.text.desc"]</div>
            <i class="bi bi-arrow-right home-feature-arrow"></i>
        </NavLink>

        <NavLink href="/number" class="home-feature-card">
            <div class="home-feature-icon home-feature-icon-text">123</div>
            <div class="home-feature-title">@Loc["home.feature.number.title"]</div>
            <div class="home-feature-desc">@Loc["home.feature.number.desc"]</div>
            <i class="bi bi-arrow-right home-feature-arrow"></i>
        </NavLink>

        <NavLink href="/wheel" class="home-feature-card">
            <div class="home-feature-icon"><i class="bi bi-arrow-repeat"></i></div>
            <div class="home-feature-title">@Loc["home.feature.wheel.title"]</div>
            <div class="home-feature-desc">@Loc["home.feature.wheel.desc"]</div>
            <i class="bi bi-arrow-right home-feature-arrow"></i>
        </NavLink>

        <NavLink href="/groupshuffler" class="home-feature-card">
            <div class="home-feature-icon"><i class="bi bi-people-fill"></i></div>
            <div class="home-feature-title">@Loc["home.feature.groupshuffler.title"]</div>
            <div class="home-feature-desc">@Loc["home.feature.groupshuffler.desc"]</div>
            <i class="bi bi-arrow-right home-feature-arrow"></i>
        </NavLink>

        <NavLink href="/shiftplanner" class="home-feature-card">
            <div class="home-feature-icon"><i class="bi bi-clock"></i></div>
            <div class="home-feature-title">@Loc["home.feature.shiftplanner.title"]</div>
            <div class="home-feature-desc">@Loc["home.feature.shiftplanner.desc"]</div>
            <i class="bi bi-arrow-right home-feature-arrow"></i>
        </NavLink>

        <NavLink href="/movies" class="home-feature-card">
            <div class="home-feature-icon"><i class="bi bi-film"></i></div>
            <div class="home-feature-title">@Loc["home.feature.movies.title"]</div>
            <div class="home-feature-desc">@Loc["home.feature.movies.desc"]</div>
            <i class="bi bi-arrow-right home-feature-arrow"></i>
        </NavLink>
    </div>

    <div class="home-tagline">
        <h2 class="home-tagline-title">@Loc["home.tagline"]</h2>

        <div class="home-stats-grid">
            <div class="home-stat-pill">
                <i class="bi bi-lightning-charge home-stat-icon"></i>
                <div class="home-stat-value">@Loc["home.stat.instant.value"]</div>
                <div class="home-stat-label">@Loc["home.stat.instant.label"]</div>
            </div>
            <div class="home-stat-pill">
                <i class="bi bi-shield-check home-stat-icon"></i>
                <div class="home-stat-value">@Loc["home.stat.free.value"]</div>
                <div class="home-stat-label">@Loc["home.stat.free.label"]</div>
            </div>
            <div class="home-stat-pill">
                <i class="bi bi-lock home-stat-icon"></i>
                <div class="home-stat-value">@Loc["home.stat.private.value"]</div>
                <div class="home-stat-label">@Loc["home.stat.private.label"]</div>
            </div>
            <div class="home-stat-pill">
                <i class="bi bi-infinity home-stat-icon"></i>
                <div class="home-stat-value">@Loc["home.stat.unlimited.value"]</div>
                <div class="home-stat-label">@Loc["home.stat.unlimited.label"]</div>
            </div>
        </div>
    </div>

    <section class="home-livestats-card" aria-label="@Loc["home.livestats.aria"]">
        <span class="home-livestats-live" aria-hidden="true">
            <span class="home-livestats-dot"></span>
        </span>

        <h2 class="home-livestats-title">@Loc["home.livestats.title"]</h2>

        <div class="home-stats-grid home-livestats-grid">
            <div class="home-stat-pill home-livestat-pill">
                <i class="bi bi-shuffle home-stat-icon"></i>
                <div class="home-stat-value">@Format(_stats?.Total)</div>
                <div class="home-stat-label">@Loc["home.livestats.randomizations"]</div>
            </div>
            <div class="home-stat-pill home-livestat-pill">
                <i class="bi bi-arrow-repeat home-stat-icon"></i>
                <div class="home-stat-value">@Format(_stats?.WheelSpins)</div>
                <div class="home-stat-label">@Loc["home.livestats.wheelSpins"]</div>
            </div>
            <div class="home-stat-pill home-livestat-pill">
                <i class="bi bi-coin home-stat-icon"></i>
                <div class="home-stat-value">@Format(_stats?.HeadsLanded)</div>
                <div class="home-stat-label">@Loc["home.livestats.headsLanded"]</div>
            </div>
            <div class="home-stat-pill home-livestat-pill">
                <i class="bi bi-cone-striped home-stat-icon"></i>
                <div class="home-stat-value">@Format(_stats?.DaysWithoutAccident)</div>
                <div class="home-stat-label">@Loc["home.livestats.daysNoAccident"]</div>
            </div>
        </div>
    </section>
</div>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(12);

    private StatsSnapshot? _stats;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        _stats = await Stats.GetAsync(_cts.Token);
        _ = PollAsync();
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    // Background refresh loop.
    private async Task PollAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(RefreshInterval);
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                var fresh = await Stats.GetAsync(_cts.Token);
                // re-render when a number actually changed.
                if (fresh is not null && fresh != _stats)
                {
                    _stats = fresh;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // navigated away
        }
    }

    // "-" until stats load; InvariantCulture for consistent separators
    private static string Format(int? n) =>
        n is int v ? v.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) : "-";

    public void Dispose()
    {
        Loc.LanguageChanged -= OnLanguageChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
