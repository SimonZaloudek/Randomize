@page "/movies"
@using Randomize.Web.Services
@using System.Net.Http.Json
@inject HttpClient Http
@inject LocalizationService Loc
@implements IDisposable

<PageTitle>@Loc["movies.pageTitle"]</PageTitle>

<div class="movies-page">

    <header class="movies-filter">
        <div class="movies-filter-head">
            <h2 class="page-title">@Loc["movies.title"]</h2>
            <p>@Loc["movies.subtitle"]</p>
            <p class="powered-credit">@Loc["movies.poweredBy"] <a href="https://www.themoviedb.org" target="_blank" rel="noopener">TMDB</a></p>
        </div>

        <div class="movies-type-toggle" role="radiogroup" aria-label="@Loc["movies.typeAria"]">
            <button type="button"
                    class="movies-type-opt @(_type=="movie" ? "active" : "")"
                    role="radio"
                    aria-checked="@(_type=="movie" ? "true" : "false")"
                    @onclick='() => SetType("movie")'
                    disabled="@_busy">
                <i class="bi bi-film"></i> @Loc["movies.type.movie"]
            </button>
            <button type="button"
                    class="movies-type-opt @(_type=="tv" ? "active" : "")"
                    role="radio"
                    aria-checked="@(_type=="tv" ? "true" : "false")"
                    @onclick='() => SetType("tv")'
                    disabled="@_busy">
                <i class="bi bi-tv"></i> @Loc["movies.type.tv"]
            </button>
        </div>

        <div class="movies-multi-row">

            <!-- Genres (multi-select) -->
            @if (CurrentGenres is { Count: > 0 } genres)
            {
                <div class="movies-multi">
                    <button type="button"
                            class="movies-multi-trigger @(_openMenu == "genres" ? "open" : "")"
                            aria-haspopup="listbox"
                            aria-expanded="@(_openMenu == "genres" ? "true" : "false")"
                            @onclick='() => ToggleMenu("genres")'
                            disabled="@_busy">
                        <span class="movies-multi-label">@Loc["movies.genres"]</span>
                        @if (_selectedGenres.Count > 0)
                        {
                            <span class="movies-multi-count">@_selectedGenres.Count</span>
                        }
                        <i class="bi bi-chevron-down movies-multi-chevron"></i>
                    </button>
                    @if (_openMenu == "genres")
                    {
                        <div class="movies-multi-backdrop" @onclick="CloseMenu"></div>
                        <div class="movies-multi-panel" role="listbox" aria-multiselectable="true">
                            <div class="movies-multi-list">
                                @foreach (var g in genres)
                                {
                                    var id = g.Id;
                                    var sel = _selectedGenres.Contains(id);
                                    <button type="button"
                                            class="movies-multi-option @(sel ? "active" : "")"
                                            role="option"
                                            aria-selected="@(sel ? "true" : "false")"
                                            @onclick="() => ToggleGenre(id)">
                                        <i class="bi @(sel ? "bi-check-square-fill" : "bi-square")"></i>
                                        <span>@g.Name</span>
                                    </button>
                                }
                            </div>
                            @if (_selectedGenres.Count > 0)
                            {
                                <div class="movies-multi-foot">
                                    <button type="button" class="movies-multi-clear" @onclick="ClearGenres">
                                        @Loc["movies.genre.clear"]
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Language (single-select) -->
            <div class="movies-multi">
                <button type="button"
                        class="movies-multi-trigger @(_openMenu == "lang" ? "open" : "")"
                        aria-haspopup="listbox"
                        aria-expanded="@(_openMenu == "lang" ? "true" : "false")"
                        @onclick='() => ToggleMenu("lang")'
                        disabled="@_busy">
                    <span class="movies-multi-label">@Loc["movies.language"]</span>
                    <span class="movies-multi-value">@(_language is null ? Loc["movies.any"] : LangName(_language))</span>
                    <i class="bi bi-chevron-down movies-multi-chevron"></i>
                </button>
                @if (_openMenu == "lang")
                {
                    <div class="movies-multi-backdrop" @onclick="CloseMenu"></div>
                    <div class="movies-multi-panel" role="listbox">
                        <div class="movies-multi-list">
                            <button type="button" class="movies-multi-option @(_language is null ? "active" : "")"
                                    role="option" @onclick="() => SetLanguage(null)">
                                <span>@Loc["movies.any"]</span>
                            </button>
                            @foreach (var l in Languages)
                            {
                                var code = l.Code;
                                <button type="button" class="movies-multi-option @(_language == code ? "active" : "")"
                                        role="option" @onclick="() => SetLanguage(code)">
                                    <span>@l.Name</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Country (single-select) -->
            <div class="movies-multi">
                <button type="button"
                        class="movies-multi-trigger @(_openMenu == "country" ? "open" : "")"
                        aria-haspopup="listbox"
                        aria-expanded="@(_openMenu == "country" ? "true" : "false")"
                        @onclick='() => ToggleMenu("country")'
                        disabled="@_busy">
                    <span class="movies-multi-label">@Loc["movies.country"]</span>
                    <span class="movies-multi-value">@(_country is null ? Loc["movies.any"] : CountryName(_country))</span>
                    <i class="bi bi-chevron-down movies-multi-chevron"></i>
                </button>
                @if (_openMenu == "country")
                {
                    <div class="movies-multi-backdrop" @onclick="CloseMenu"></div>
                    <div class="movies-multi-panel" role="listbox">
                        <div class="movies-multi-list">
                            <button type="button" class="movies-multi-option @(_country is null ? "active" : "")"
                                    role="option" @onclick="() => SetCountry(null)">
                                <span>@Loc["movies.any"]</span>
                            </button>
                            @foreach (var c in Countries)
                            {
                                var code = c.Code;
                                <button type="button" class="movies-multi-option @(_country == code ? "active" : "")"
                                        role="option" @onclick="() => SetCountry(code)">
                                    <span>@c.Name</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="movies-year-range">
            <label class="movies-year-range-label">@Loc["movies.releaseYear"]</label>
            <div class="movies-year-inputs">
                <input type="number" class="movies-year-input"
                       min="1900" max="2030"
                       placeholder="@Loc["movies.releaseFrom"]"
                       @bind="_fromYear" disabled="@_busy" />
                <span class="movies-year-sep">–</span>
                <input type="number" class="movies-year-input"
                       min="1900" max="2030"
                       placeholder="@Loc["movies.releaseTo"]"
                       @bind="_toYear" disabled="@_busy" />
            </div>
        </div>

        <div class="movies-min-rating">
            <label class="movies-min-rating-label" for="min-rating">
                @Loc["movies.minRating"]
                <strong>@_minRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</strong>
                <span class="movies-min-rating-star">★</span>
            </label>
            <input id="min-rating" type="range"
                   min="0" max="9.5" step="0.5"
                   @bind="_minRating" @bind:event="oninput"
                   disabled="@_busy" />
        </div>

        <div class="movies-min-rating">
            <label class="movies-min-rating-label" for="min-votes">
                @Loc["movies.minVotes"]
                <strong>@(_minVotes == 0 ? Loc["movies.anyVotes"] : _minVotes.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</strong>
            </label>
            <input id="min-votes" type="range"
                   min="0" max="5000" step="100"
                   @bind="_minVotes" @bind:event="oninput"
                   disabled="@_busy" />
        </div>

        <button class="tool-btn movies-randomize" @onclick="Randomize" disabled="@_busy">
            @if (_busy)
            {
                <span><i class="bi bi-arrow-clockwise movies-spin"></i> @Loc["movies.picking"]</span>
            }
            else
            {
                <span><i class="bi bi-shuffle"></i> @Loc["movies.randomize"]</span>
            }
        </button>

        @if (_result is { TotalResults: > 0 } pool && _error is null)
        {
            <div class="movies-pool @(pool.TotalResults <= 3 ? "tight" : "")">
                @if (pool.TotalResults == 1)
                {
                    <span><i class="bi bi-info-circle"></i> @Loc["movies.pool.onlyOneBefore"]<strong>1</strong>@Loc["movies.pool.onlyOneAfter"]</span>
                }
                else if (pool.TotalResults <= 3)
                {
                    <span><i class="bi bi-info-circle"></i> @Loc["movies.pool.onlyFewBefore"]<strong>@pool.TotalResults</strong>@Loc["movies.pool.onlyFewAfter"]</span>
                }
                else
                {
                    <span><strong>@pool.TotalResults.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</strong>@Loc["movies.pool.matchAfter"]</span>
                }
            </div>
        }

        @if (_error is not null)
        {
            <div class="movies-error" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>@_error</span>
            </div>
        }
    </header>

    @if (_result is { } r)
    {
        <article class="movies-result" @key="r.Kind + r.Id">
            <div class="movies-hero"
                 style="@(r.Backdrop is null ? "" : $"background-image: url('{r.Backdrop}');")">
                <div class="movies-hero-fade" aria-hidden="true"></div>
                <div class="movies-hero-inner">
                    @if (r.Poster is not null)
                    {
                        <img src="@r.Poster" alt="@(r.Title) poster" class="movies-poster" loading="lazy" />
                    }
                    <div class="movies-hero-info">
                        @if (!string.IsNullOrEmpty(r.Tagline))
                        {
                            <div class="movies-tagline">@r.Tagline</div>
                        }
                        <h1 class="movies-title">@r.Title</h1>

                        <div class="movies-meta">
                            @if (!string.IsNullOrEmpty(r.Year))
                            {
                                <span>@r.Year</span>
                            }
                            @if (r.Runtime is int rt && rt > 0)
                            {
                                <span>@FormatRuntime(rt)</span>
                            }
                            @if (r.Seasons is int s && s > 0)
                            {
                                <span>@s @(s == 1 ? Loc["movies.season"] : Loc["movies.seasons"])</span>
                            }
                            @if (r.Episodes is int ep && ep > 0)
                            {
                                <span>@ep @Loc["movies.episodes"]</span>
                            }
                        </div>

                        @if (r.Genres.Count > 0)
                        {
                            <div class="movies-genre-pills">
                                @foreach (var g in r.Genres)
                                {
                                    <span class="movies-genre-pill">@g</span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(r.Overview))
                        {
                            <p class="movies-overview">@r.Overview</p>
                        }

                        <div class="movies-links">
                            @if (r.Links?.Tmdb is { } t)
                            {
                                <a href="@t" target="_blank" rel="noopener" class="movies-link">
                                    <i class="bi bi-box-arrow-up-right"></i> TMDB
                                </a>
                            }
                            @if (r.Links?.Imdb is { } i)
                            {
                                <a href="@i" target="_blank" rel="noopener" class="movies-link">
                                    <i class="bi bi-box-arrow-up-right"></i> IMDb
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(r.Homepage))
                            {
                                <a href="@r.Homepage" target="_blank" rel="noopener" class="movies-link">
                                    <i class="bi bi-house"></i> @Loc["movies.official"]
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (r.Ratings is { Count: > 0 })
            {
                <section class="movies-section movies-ratings-section">
                    <h3 class="movies-section-title">@Loc["movies.section.ratings"]</h3>
                    <div class="movies-ratings">
                        @foreach (var rating in r.Ratings)
                        {
                            var meta = RatingMeta(rating);
                            <div class="movies-rating" style="--rating-color: @meta.Color">
                                <div class="movies-rating-head">
                                    @switch (rating.Source)
                                    {
                                        case "TMDB":
                                            <span class="movies-brand movies-brand-tmdb">TMDb</span>
                                            break;
                                        case "IMDb":
                                            <span class="movies-brand movies-brand-imdb">IMDb</span>
                                            break;
                                        case "Rotten Tomatoes":
                                            <span class="movies-brand @(rating.Score >= 60 ? "movies-brand-rt-fresh" : "movies-brand-rt-rotten")"
                                                  aria-label="@(rating.Score >= 60 ? "Fresh" : "Rotten")"></span>
                                            <span class="movies-rating-source">Rotten Tomatoes</span>
                                            break;
                                        case "Metacritic":
                                            <span class="movies-brand movies-brand-metacritic">M</span>
                                            <span class="movies-rating-source">Metacritic</span>
                                            break;
                                        default:
                                            <span class="movies-rating-source">@rating.Source</span>
                                            break;
                                    }
                                </div>
                                <div class="movies-rating-score">
                                    @FormatScore(rating.Score, rating.Max)<small>@FormatScoreSuffix(rating.Max)</small>
                                </div>
                                @if (rating.Source == "Rotten Tomatoes")
                                {
                                    <div class="movies-rating-tag">@(rating.Score >= 60 ? Loc["movies.rating.fresh"] : Loc["movies.rating.rotten"])</div>
                                }
                                else if (rating.Votes > 0)
                                {
                                    <div class="movies-rating-votes">@rating.Votes.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) @Loc["movies.rating.votes"]</div>
                                }
                            </div>
                        }
                    </div>
                </section>
                }

                @if (HasStatTiles(r.Stats, r.Kind))
                {
                    <section class="movies-section movies-stats-section">
                        <h3 class="movies-section-title">@Loc["movies.section.stats"]</h3>
                        <div class="movies-quick-stats">
                            @if (r.Stats!.Popularity > 0)
                            {
                                <div class="movies-stat-tile">
                                    <div class="movies-stat-tile-label">@Loc["movies.stat.popularity"]</div>
                                    <div class="movies-stat-tile-value">@r.Stats.Popularity.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(r.Stats!.Status))
                            {
                                <div class="movies-stat-tile">
                                    <div class="movies-stat-tile-label">@Loc["movies.stat.status"]</div>
                                    <div class="movies-stat-tile-value">@r.Stats.Status</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(r.Stats!.OriginalLanguage))
                            {
                                <div class="movies-stat-tile">
                                    <div class="movies-stat-tile-label">@Loc["movies.stat.language"]</div>
                                    <div class="movies-stat-tile-value">@r.Stats.OriginalLanguage</div>
                                </div>
                            }
                            @if (r.Stats.ProductionCountries is { Count: > 0 } pc)
                            {
                                <div class="movies-stat-tile">
                                    <div class="movies-stat-tile-label">@Loc["movies.stat.country"]</div>
                                    <div class="movies-stat-tile-value">@string.Join(" · ", pc)</div>
                                </div>
                            }
                            @if (r.Kind == "movie" && r.Stats.Budget is long b && b > 0)
                            {
                                <div class="movies-stat-tile">
                                    <div class="movies-stat-tile-label">@Loc["movies.stat.budget"]</div>
                                    <div class="movies-stat-tile-value">@FormatMoney(b)</div>
                                </div>
                            }
                            @if (r.Kind == "movie" && r.Stats.Revenue is long rv && rv > 0)
                            {
                                <div class="movies-stat-tile">
                                    <div class="movies-stat-tile-label">@Loc["movies.stat.revenue"]</div>
                                    <div class="movies-stat-tile-value">@FormatMoney(rv)</div>
                                </div>
                            }
                        </div>
                    </section>
                }

            @if (r.Awards is { } awards && HasAnyAward(awards))
            {
                <section class="movies-section movies-awards-section">
                    <h3 class="movies-section-title">@Loc["movies.section.awards"]</h3>
                    <div class="movies-awards-row">
                        @if (awards.Highlights is { Count: > 0 } highlights)
                        {
                            @foreach (var h in highlights)
                            {
                                <div class="movies-award @(h.Kind == "win" ? "win" : "nom")">
                                    <i class="bi @(h.Kind == "win" ? "bi-trophy-fill" : "bi-star")"></i>
                                    <div class="movies-award-count">@h.Count</div>
                                    <div class="movies-award-label">
                                        @h.Label@(h.Count == 1 ? "" : "s") @(h.Kind == "win" ? Loc["movies.award.won"] : Loc["movies.award.nominated"])
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            @if ((awards.TotalWins ?? 0) > 0)
                            {
                                <div class="movies-award win">
                                    <i class="bi bi-trophy-fill"></i>
                                    <div class="movies-award-count">@awards.TotalWins</div>
                                    <div class="movies-award-label">@(awards.TotalWins == 1 ? Loc["movies.award.win"] : Loc["movies.award.wins"])</div>
                                </div>
                            }
                            @if ((awards.TotalNominations ?? 0) > 0)
                            {
                                <div class="movies-award nom">
                                    <i class="bi bi-star"></i>
                                    <div class="movies-award-count">@awards.TotalNominations</div>
                                    <div class="movies-award-label">@(awards.TotalNominations == 1 ? Loc["movies.award.nomination"] : Loc["movies.award.nominations"])</div>
                                </div>
                            }
                        }
                    </div>

                    @if (awards.Highlights is { Count: > 0 } && ((awards.TotalWins ?? 0) > 0 || (awards.TotalNominations ?? 0) > 0))
                    {
                        <div class="movies-awards-summary">
                            @if ((awards.TotalWins ?? 0) > 0)
                            {
                                <span><strong>@awards.TotalWins!.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</strong>@Loc["movies.award.totalWinsAfter"]</span>
                            }
                            @if ((awards.TotalWins ?? 0) > 0 && (awards.TotalNominations ?? 0) > 0)
                            {
                                <span class="movies-awards-sep">·</span>
                            }
                            @if ((awards.TotalNominations ?? 0) > 0)
                            {
                                <span><strong>@awards.TotalNominations!.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</strong>@Loc["movies.award.totalNominationsAfter"]</span>
                            }
                        </div>
                    }
                </section>
            }

            @if (r.Cast is { Count: > 0 })
            {
                <section class="movies-section movies-cast-section">
                    <h3 class="movies-section-title">@Loc["movies.section.cast"]</h3>
                    <div class="movies-cast-row">
                        @foreach (var c in r.Cast)
                        {
                            <div class="movies-cast-card">
                                <div class="movies-cast-avatar">
                                    @if (c.Profile is not null)
                                    {
                                        <img src="@c.Profile" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill"></i>
                                    }
                                </div>
                                <div class="movies-cast-name">@c.Name</div>
                                @if (!string.IsNullOrEmpty(c.Character))
                                {
                                    <div class="movies-cast-char">@c.Character</div>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            @if (HasAnyProvider(r.Providers))
            {
                <section class="movies-section movies-providers-section">
                    <h3 class="movies-section-title">
                        @Loc["movies.section.providers"]
                        @if (!string.IsNullOrEmpty(r.Region))
                        {
                            <small>(@r.Region)</small>
                        }
                    </h3>
                    @if (r.Providers!.Stream is { Count: > 0 } stream)
                    {
                        @ProviderGroup(Loc["movies.providers.stream"], stream)
                    }
                    @if (r.Providers.Rent is { Count: > 0 } rent)
                    {
                        @ProviderGroup(Loc["movies.providers.rent"], rent)
                    }
                    @if (r.Providers.Buy is { Count: > 0 } buy)
                    {
                        @ProviderGroup(Loc["movies.providers.buy"], buy)
                    }
                    @if (r.Providers.Free is { Count: > 0 } free)
                    {
                        @ProviderGroup(Loc["movies.providers.free"], free)
                    }
                    <div class="movies-providers-attr">@Loc["movies.providers.attr"]</div>
                </section>
            }

            @if (r.Images is { Count: > 0 })
            {
                <section class="movies-section movies-gallery">
                    <h3 class="movies-section-title">@Loc["movies.section.gallery"]</h3>
                    <div class="movies-gallery-large">
                        <img src="@(_galleryActive ?? r.Images[0])" alt="" />
                    </div>
                    <div class="movies-gallery-thumbs">
                        @foreach (var img in r.Images)
                        {
                            var src = img;
                            <button type="button"
                                    class="movies-gallery-thumb @(src == _galleryActive ? "active" : "")"
                                    @onmouseover="() => _galleryActive = src"
                                    @onfocus="() => _galleryActive = src"
                                    @onclick="() => _galleryActive = src"
                                    aria-label="@Loc["movies.gallery.aria"]">
                                <img src="@src" alt="" loading="lazy" />
                            </button>
                        }
                    </div>
                </section>
            }
        </article>
    }
    else if (!_busy)
    {
        <div class="movies-empty">
            <i class="bi bi-film"></i>
            <p>@Loc["movies.empty"]</p>
        </div>
    }
</div>

@code {
    private string _type = "movie";
    private readonly HashSet<int> _selectedGenres = new();
    private string? _openMenu;        // which dropdown is open ("genres" / "lang" / "country")
    private string? _language;        // TMDB original-language filter (iso-639-1), null = any
    private string? _country;         // TMDB origin-country filter (iso-3166-1), null = any
    private double _minRating = 0.0;
    private int _minVotes = 0;
    private int? _fromYear;
    private int? _toYear;
    private bool _busy;
    private string? _error;
    private MovieResult? _result;
    private string? _galleryActive;

    private GenresResponse? _genres;
    private List<Genre>? CurrentGenres => _type == "tv" ? _genres?.Tv : _genres?.Movie;

    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        try { _genres = await Http.GetFromJsonAsync<GenresResponse>("api/movies/genres"); }
        catch {}
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Loc.LanguageChanged -= OnLanguageChanged;

    private void SetType(string t)
    {
        if (_type == t) return;
        _type = t;
        _selectedGenres.Clear();   // movie and tv have different genre IDs
    }

    private void ToggleGenre(int id)
    {
        if (!_selectedGenres.Add(id)) _selectedGenres.Remove(id);
    }

    private void ClearGenres() => _selectedGenres.Clear();

    private void ToggleMenu(string name) => _openMenu = _openMenu == name ? null : name;
    private void CloseMenu() => _openMenu = null;
    private void SetLanguage(string? code) { _language = code; _openMenu = null; }
    private void SetCountry(string? code) { _country = code; _openMenu = null; }

    private static string? LangName(string code) => Languages.FirstOrDefault(l => l.Code == code)?.Name;
    private static string? CountryName(string code) => Countries.FirstOrDefault(c => c.Code == code)?.Name;

    // curated common options (TMDB takes one code each); names stay English
    public sealed record Opt(string Code, string Name);

    private static readonly List<Opt> Languages = new()
    {
