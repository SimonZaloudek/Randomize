    private async Task Randomize()
    {
        _busy = true;
        _error = null;
        StateHasChanged();

        // 15s cap
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));

        try
        {
            // swap if user inverted the range
            int? from = _fromYear, to = _toYear;
            if (from is int f && to is int t && f > t) (from, to) = (to, from);

            var q = $"type={_type}";
            if (_selectedGenres.Count > 0)
                q += "&genres=" + string.Join(",", _selectedGenres);
            if (_minRating > 0)
                q += "&min_rating=" + _minRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
            if (_minVotes > 0)
                q += "&min_votes=" + _minVotes;
            if (from is int fy) q += "&from_year=" + fy;
            if (to is int ty) q += "&to_year=" + ty;
            if (_language is not null) q += "&lang=" + _language;
            if (_country is not null) q += "&country=" + _country;

            var res = await Http.GetAsync("api/movies/random?" + q, cts.Token);
            if (res.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _error = Loc["movies.error.noMatches"];
                return;
            }
            res.EnsureSuccessStatusCode();
            _result = await res.Content.ReadFromJsonAsync<MovieResult>(cts.Token);
            _galleryActive = _result?.Images?.FirstOrDefault();
            // "movie" is counted server-side in the function so it can't be spoofed
        }
        catch (OperationCanceledException)
        {
            _error = Loc["movies.error.timeout"];
        }
        catch
        {
            _error = Loc["movies.error.generic"];
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private RenderFragment ProviderGroup(string label, List<Provider> items) => @<div class="movies-providers-row">
        <div class="movies-providers-row-label">@label</div>
        @foreach (var p in items)
        {
            <div class="movies-provider" title="@p.Name">
                @if (p.Logo is not null)
                {
                    <img src="@p.Logo" alt="@p.Name" loading="lazy" />
                }
                <span class="movies-provider-name">@p.Name</span>
            </div>
        }
    </div>;

    private static bool HasStatTiles(MovieStats? s, string kind)
    {
        if (s is null) return false;
        if (s.Popularity > 0) return true;
        if (!string.IsNullOrEmpty(s.Status)) return true;
        if (!string.IsNullOrEmpty(s.OriginalLanguage)) return true;
        if (s.ProductionCountries is { Count: > 0 }) return true;
        if (kind == "movie" && ((s.Budget ?? 0) > 0 || (s.Revenue ?? 0) > 0)) return true;
        return false;
    }

    private static bool HasAnyProvider(MovieProviders? p) =>
        p is not null && (
            (p.Stream?.Count ?? 0) > 0 ||
            (p.Rent?.Count   ?? 0) > 0 ||
            (p.Buy?.Count    ?? 0) > 0 ||
            (p.Free?.Count   ?? 0) > 0);

    private static string FormatRuntime(int minutes)
    {
        if (minutes < 60) return $"{minutes} min";
        int h = minutes / 60, m = minutes % 60;
        return m == 0 ? $"{h}h" : $"{h}h {m}m";
    }

    private static string FormatMoney(long n)
    {
        if (n >= 1_000_000_000) return $"${(n / 1_000_000_000.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}B";
        if (n >= 1_000_000)     return $"${(n / 1_000_000.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}M";
        if (n >= 1_000)         return $"${(n / 1_000.0).ToString("0", System.Globalization.CultureInfo.InvariantCulture)}K";
        return $"${n}";
    }

    // /10 = one decimal, /100 = integer
    private static string FormatScore(double score, double max) =>
        max > 10
            ? score.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
            : score.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatScoreSuffix(double max) =>
        max == 100 ? "%" : $"/{max.ToString("0", System.Globalization.CultureInfo.InvariantCulture)}";

    // brand colour + icon; RT/MC pick variant by score
    private static (string Icon, string Color) RatingMeta(Rating r) => r.Source switch
    {
        "TMDB"                                  => ("bi-collection-play-fill", "#01b4e4"),
        "IMDb"                                  => ("bi-star-fill",            "#f5c518"),
        "Rotten Tomatoes" when r.Score >= 60    => ("bi-circle-fill",          "#fa320a"),
        "Rotten Tomatoes"                        => ("bi-droplet-fill",         "#33a833"),
        "Metacritic" when r.Score >= 75          => ("",                        "#66cc33"),
        "Metacritic" when r.Score >= 50          => ("",                        "#ffcc33"),
        "Metacritic"                             => ("",                        "#ff4d4d"),
        _                                        => ("bi-info-circle",          "var(--accent-soft)")
    };

    private static bool HasAnyAward(Awards a) =>
        (a.Highlights?.Count ?? 0) > 0 ||
        (a.TotalWins ?? 0) > 0 ||
        (a.TotalNominations ?? 0) > 0;

