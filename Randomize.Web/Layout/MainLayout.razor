@inherits LayoutComponentBase
@using Randomize.Web.Pages.Media
@using Microsoft.AspNetCore.Components.Routing
@inject LocalizationService Loc
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<!-- song-colour glow that rings the app card; lit only while a song plays -->
<div class="app-song-glow" aria-hidden="true"><div class="app-song-glow-wave"></div></div>

<div class="app-container">
    <!-- Sidebar -->
    <div class="sidebar @(isSidebarOpen ? "open" : "closed")">
        <div class="sidebar-header">
            <img src="brand/RANDLOGO1.png" alt="Randomize Icon" class="logo" />
        </div>

        <!-- A click on any NavLink bubbles up here and closes the sidebar on
             mobile. The theme switch sits outside this nav so it won't trigger. -->
        <nav class="sidebar-nav" @onclick="CloseSidebar">
            <NavLink href="/" class="nav-item" Match="NavLinkMatch.All">
                <i class="bi bi-house"></i> @Loc["nav.home"]
            </NavLink>
            <NavLink href="/base" class="nav-item">
                <i class="bi bi-shuffle"></i> @Loc["nav.base"]
            </NavLink>
            <NavLink href="/wheel" class="nav-item">
                <i class="bi bi-arrow-repeat"></i> @Loc["nav.wheel"]
            </NavLink>
            <NavLink href="/groupshuffler" class="nav-item">
                <i class="bi bi-people-fill"></i> @Loc["nav.groupshuffler"]
            </NavLink>
            <NavLink href="/shiftplanner" class="nav-item">
                <i class="bi bi-clock"></i> @Loc["nav.shiftplanner"]
            </NavLink>
            <NavLink href="/movies" class="nav-item">
                <i class="bi bi-film"></i> @Loc["nav.movies"]
            </NavLink>
            <NavLink href="/meals" class="nav-item">
                <MealIcon Class="nav-meal-icon" /> @Loc["nav.meals"]
            </NavLink>
            <NavLink href="/gamershub" class="nav-item">
                <i class="bi bi-controller"></i> @Loc["nav.gamers"]
            </NavLink>
            <NavLink href="/rps" class="nav-item">
                <i class="bi bi-scissors"></i> @Loc["nav.rps"]
            </NavLink>
            <NavLink href="/songs" class="nav-item nav-item-songs">
                <img src="brand/spotify-icon.svg" alt="" class="nav-spotify-icon" /> @Loc["nav.songs"]
            </NavLink>

            <div class="nav-divider" aria-hidden="true"></div>

            <NavLink href="/settings" class="nav-item">
                <i class="bi bi-gear"></i> @Loc["nav.settings"]
            </NavLink>
            <NavLink href="/contact" class="nav-item">
                <i class="bi bi-envelope"></i> @Loc["nav.contact"]
            </NavLink>
        </nav>

        <!-- Version + About -->
        <div class="sidebar-footer">
            <span class="sidebar-version">Beta v0.90</span>
            <div class="sidebar-footer-actions">
                <ShareButton Compact="true" />
                <NavLink href="/about" class="sidebar-about" @onclick="CloseSidebar">@Loc["nav.about"]</NavLink>
            </div>
        </div>
    </div>

    <!-- Dim the content behind the open sidebar (mobile only); tap to close. -->
    <div class="sidebar-backdrop @(isSidebarOpen ? "visible" : "")" @onclick="CloseSidebar"></div>

    <!-- Main content -->
    <div class="content" style="@_bloomStyle">
        <!-- Only the "open" affordance is needed. Closing happens via backdrop
             tap or a nav-link tap, so no on-screen close button is necessary. -->
        @if (!isSidebarOpen)
        {
            <button class="sidebar-toggle" @onclick="ToggleSidebar" aria-label="Open menu">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z" />
                </svg>
            </button>
        }

        @if (ShowBack)
        {
            <button class="content-back" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> @Loc["nav.back"]
            </button>
        }

        @Body

        <!-- Songs lives here (not as a routed page) so it stays alive across
             navigation: the inline player keeps playing and the result is kept.
             It shows on /songs and slides off-screen (player drops to the corner) elsewhere. -->
        <Songs />
    </div>
</div>

<!-- First-visit welcome toast (shows once, then remembered in localStorage).
     Outside .app-container so its fixed position ignores the card hover lift. -->
<WelcomeToast />

@code {
    // theme is applied by index.html on initial load + Settings page on change
    private bool isSidebarOpen = false;

    // randomised positions for the two content-background honeycomb blooms,
    // re-rolled on every navigation so each page glows a little differently
    private string _bloomStyle = "";

    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        Nav.LocationChanged += OnLocationChanged;
        RollBlooms();
        await Loc.InitializeAsync();
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RollBlooms();
        InvokeAsync(StateHasChanged);
    }

    // back button on every page except home and the hubs that carry their own back
    private bool ShowBack
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            return path.Length > 0 && path != "gamershub" && !path.StartsWith("lol");
        }
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");

    private void RollBlooms()
    {
        var r = Random.Shared;
        _bloomStyle = $"--hb1:{r.Next(0, 101)}% {r.Next(0, 40)}%;--hb2:{r.Next(0, 101)}% {r.Next(60, 101)}%";
    }

    public void Dispose()
    {
        Loc.LanguageChanged -= OnLanguageChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;

    // no-op on desktop - CSS keeps the sidebar visible there
    private void CloseSidebar() => isSidebarOpen = false;
}
