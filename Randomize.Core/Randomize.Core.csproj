<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
  </ItemGroup>

  <!-- link the CF Pages Functions (they live at /functions/ by CF convention) -->
  <ItemGroup>
    <None Include="..\functions\**\*.js" Link="Backend\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
