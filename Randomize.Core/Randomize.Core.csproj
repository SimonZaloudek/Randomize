<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
  </ItemGroup>

  <!--
    Cloudflare Pages Functions live at /functions/ by Cloudflare convention -
    they can't be moved without breaking deploys, and they run on V8 (not .NET).
    Linking them here just makes them visible/editable in Solution Explorer
    under Randomize.Core; the files themselves stay at the repo root.
  -->
  <ItemGroup>
    <None Include="..\functions\**\*.js" Link="Backend\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
